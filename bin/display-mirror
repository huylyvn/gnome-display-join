#!/bin/bash

{
    echo "=== $(date) ==="
    echo "DISPLAY=$DISPLAY"
    echo "WAYLAND_DISPLAY=$WAYLAND_DISPLAY"
    echo "XDG_RUNTIME_DIR=$XDG_RUNTIME_DIR"

    /usr/bin/gdctl set --persistent \
      --logical-monitor --primary \
      --monitor eDP-1 --mode 1920x1080@59.934 \
      --monitor HDMI-1 --mode 1920x1080@59.940

    echo "exit=$?"
} >> /tmp/display-mirror.log 2>&1
